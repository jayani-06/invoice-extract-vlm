# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Data (raw/processed datasets are large & licensed separately — never commit)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
# Phase 5 service state: uploaded invoice images and the reviewer-decision
# database. Real invoices may land here, so it is never committed.
data/service/
*.zip
*.tar.gz

# Model weights / checkpoints
*.pt
*.pth
*.safetensors
checkpoints/

# Env / secrets
.env
.env.*
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/

# Phase 1: generated image corpus and ablation reports are reproducible
# from canonical JSON via `make corpus` / `make ablation`, so they are not tracked.
reports/
data/processed/*/images/
data/processed/*/ocr_gold/
data/processed/*/manifest.jsonl

# Demo artifacts: rebuilt with `make demo-cache`, and the VLM payload
# round-trips through Colab rather than living in the repo.
demo_cache/
vlm_outputs.json

# The Colab payloads ARE tracked: the notebooks clone the repo to get them,
# which removes a manual file upload from the GPU run. The eval payload is
# 6.5 MB (100 document images); the demo one is 0.5 MB.
!vlm_payload.zip
!vlm_eval_payload.zip
!vlm_eval_payload.selection.json
