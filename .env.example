# Copy to .env and fill in. Never commit the real .env.

# Kaggle (for FATURA / SROIE mirrors hosted on Kaggle)
KAGGLE_USERNAME=
KAGGLE_KEY=

# HuggingFace (for CORD, SROIE, and some FATURA mirrors on HF Hub)
HUGGINGFACE_TOKEN=

# Optional: object storage for annotated data (used by the minio profile in docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional: Label Studio (annotation UI, used by the labelstudio profile)
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=changeme123
