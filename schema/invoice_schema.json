{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/invoice-extract/v1/invoice.json",
  "title": "CanonicalInvoiceDocument",
  "description": "Canonical, dataset-agnostic representation of one invoice/receipt document. Every source dataset (FATURA, SROIE, CORD, GST invoices) is converted into this shape before annotation, training, or evaluation. schema_version is frozen at 1.0.0 for the lifetime of this project phase; breaking changes require a new major version and a migration script under scripts/migrations/.",
  "type": "object",
  "required": ["schema_version", "doc_id", "source", "document_type", "pages", "parties", "invoice_meta", "line_items", "totals"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "doc_id": {
      "type": "string",
      "description": "Globally unique id within this project, e.g. 'fatura_003217' or 'gst_synth_0042'.",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "required": ["dataset", "original_id", "split"],
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "string",
          "enum": ["fatura", "sroie", "cord", "gst_in_real", "gst_in_synthetic", "other"]
        },
        "original_id": {
          "type": "string",
          "description": "The document's id/filename in its original dataset, for traceability."
        },
        "split": {
          "type": "string",
          "enum": ["train", "val", "test"]
        },
        "license": {
          "type": "string",
          "description": "License of the source dataset (e.g. 'CC-BY-4.0', 'research-only'). Required before redistribution."
        }
      }
    },
    "language": {
      "type": "string",
      "description": "Primary document language, ISO 639-1.",
      "default": "en"
    },
    "currency": {
      "type": "string",
      "description": "ISO 4217 currency code.",
      "pattern": "^[A-Z]{3}$"
    },
    "document_type": {
      "type": "string",
      "enum": ["invoice", "receipt"]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["page_index", "image_path", "width", "height"],
        "additionalProperties": false,
        "properties": {
          "page_index": { "type": "integer", "minimum": 0 },
          "image_path": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "dpi": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "parties": {
      "type": "object",
      "required": ["vendor"],
      "additionalProperties": false,
      "properties": {
        "vendor": { "$ref": "#/$defs/party" },
        "buyer": { "$ref": "#/$defs/party" },
        "ship_to": { "$ref": "#/$defs/party" }
      }
    },
    "invoice_meta": {
      "type": "object",
      "required": ["invoice_number", "invoice_date"],
      "additionalProperties": false,
      "properties": {
        "invoice_number": { "type": ["string", "null"] },
        "invoice_date": {
          "type": ["string", "null"],
          "description": "ISO 8601 date (YYYY-MM-DD). Use null if illegible/absent rather than omitting the key.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "due_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "po_number": { "type": ["string", "null"] },
        "payment_terms": { "type": ["string", "null"] }
      }
    },
    "line_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/line_item" }
    },
    "tax_lines": {
      "type": "array",
      "items": { "$ref": "#/$defs/tax_line" },
      "default": []
    },
    "totals": {
      "type": "object",
      "required": ["grand_total"],
      "additionalProperties": false,
      "properties": {
        "subtotal": { "type": ["number", "null"] },
        "discount_total": { "type": ["number", "null"] },
        "tax_total": { "type": ["number", "null"] },
        "shipping": { "type": ["number", "null"] },
        "round_off": { "type": ["number", "null"] },
        "grand_total": { "type": ["number", "null"] },
        "amount_in_words": { "type": ["string", "null"] }
      }
    },
    "payment_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bank_name": { "type": ["string", "null"] },
        "account_number": { "type": ["string", "null"] },
        "ifsc_or_swift": { "type": ["string", "null"] },
        "upi_id": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"] },
        "terms": { "type": ["string", "null"] }
      }
    },
    "grounding": {
      "type": "array",
      "description": "Optional bounding-box provenance for any scalar field elsewhere in the document, decoupled from the value schema so plain field-value comparison never needs to know about boxes. field_path uses JSON-Pointer-like dotted/bracket notation, e.g. 'parties.vendor.name' or 'line_items[2].description'.",
      "default": [],
      "items": {
        "type": "object",
        "required": ["field_path", "page_index", "bbox"],
        "additionalProperties": false,
        "properties": {
          "field_path": { "type": "string" },
          "page_index": { "type": "integer", "minimum": 0 },
          "bbox": {
            "type": "array",
            "description": "[x0, y0, x1, y1] in absolute pixel coords of the referenced page image.",
            "items": { "type": "number" },
            "minItems": 4,
            "maxItems": 4
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "annotator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annotated_by": { "type": "string" },
        "verified": { "type": "boolean", "default": false },
        "notes": { "type": "string" }
      }
    }
  },
  "$defs": {
    "party": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": ["string", "null"] },
        "address": { "type": ["string", "null"] },
        "tax_id": {
          "type": ["string", "null"],
          "description": "Generic tax/VAT id. For Indian GST documents, prefer 'gstin' below; this stays for non-Indian datasets (FATURA/SROIE/CORD)."
        },
        "gstin": {
          "type": ["string", "null"],
          "description": "15-character Indian GST Identification Number, when applicable.",
          "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z]{1}[1-9A-Z]{1}Z[0-9A-Z]{1}$"
        },
        "phone": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] }
      }
    },
    "line_item": {
      "type": "object",
      "required": ["description"],
      "additionalProperties": false,
      "properties": {
        "line_no": { "type": ["integer", "null"] },
        "description": { "type": ["string", "null"] },
        "hsn_sac_code": {
          "type": ["string", "null"],
          "description": "Indian HSN/SAC code, when applicable; null for non-GST datasets."
        },
        "quantity": { "type": ["number", "null"] },
        "unit": { "type": ["string", "null"] },
        "unit_price": { "type": ["number", "null"] },
        "discount": { "type": ["number", "null"] },
        "tax_rate": { "type": ["number", "null"] },
        "tax_amount": { "type": ["number", "null"] },
        "line_total": { "type": ["number", "null"] }
      }
    },
    "tax_line": {
      "type": "object",
      "required": ["type", "amount"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["CGST", "SGST", "IGST", "CESS", "VAT", "GST", "SALES_TAX", "OTHER"]
        },
        "rate": { "type": ["number", "null"] },
        "amount": { "type": "number" }
      }
    }
  }
}
